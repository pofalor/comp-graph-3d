# ============================ Blender ============================
# Резервные копии, которые Blender делает при сохранении: .blend1, .blend2, ...
*.blend[0-9]*

# Файлы блокировки и временные файлы Blender
*.blend@
*.blend.lock
*_autosave.blend

# Кэши физики, симуляций и запечённых данных
blendcache_*/
*.bphys
*.bobj.gz
*.bvel.gz

# ======================== Результаты рендера ========================
# Финальные картинки в render/ коммитим, а промежуточное — нет.
render/tmp/
render/frames/
render/**/*.avi
render/**/*.mp4
render/**/*.mkv
render/**/*.mov

# Если решишь не хранить рендеры в репозитории — раскомментируй:
# render/

# Экспортированные модели (.fbx, .dae, .obj) сейчас коммитятся.
# Если они генерируются из .blend и не нужны в истории — раскомментируй:
# *.fbx
# *.dae
# *.obj
# *.mtl
# *.glb
# *.gltf

# ====================== Windows / OneDrive ======================
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Конфликты синхронизации OneDrive
*-Конфликт*
*(конфликтующая копия*

# ========================= macOS / Linux =========================
.DS_Store
._*
.Trash-*
.fuse_hidden*
*~

# ======================== Редакторы / IDE ========================
.vscode/
.idea/
*.code-workspace
*.swp
*.swo

# ================== Python (скрипты для bpy) ==================
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ============================ Прочее ============================
*.log
*.tmp
*.bak
*.zip
*.rar
*.7z
